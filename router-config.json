{
  "providers": {
    "openrouter": {
      "billing": "pay_per_token",
      "free_models": [
        "openrouter/qwen/qwen3-4b:free",
        "openrouter/openai/gpt-4o-mini:free",
        "openrouter/meta-llama/llama-3.3-70b-instruct:free",
        "openrouter/google/gemma-3-4b-it:free",
        "openrouter/google/gemma-3-12b-it:free"
      ]
    }
  },
  "model_groups": {
    "trivial": {
      "description": "Trivial tasks - free models only",
      "method": "min_cost_if_all_priced",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": []
    },
    "simple": {
      "description": "Simple tasks - free models only",
      "method": "min_cost_if_all_priced",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": ["trivial"]
    },
    "standard": {
      "description": "Standard tasks - cost-effective models",
      "method": "tiered",
      "min_gdpval": 500,
      "fallback_groups": ["complex", "operational", "scout", "fallback"]
    },
    "complex": {
      "description": "Complex tasks - GDPval >=600 (mistral-medium tier), best available",
      "method": "best",
      "min_gdpval": 600,
      "fallback_groups": ["strategic", "tactical", "operational", "scout", "fallback"]
    },
    "strategic": {
      "description": "Best available model by intelligence (max GDPval)",
      "method": "best",
      "min_gdpval": 700,
      "fallback_groups": [
        "tactical",
        "operational",
        "scout",
        "fallback"
      ]
    },
    "tactical": {
      "description": "GDPval >=600: mistral-medium tier, best available",
      "method": "best",
      "min_gdpval": 600,
      "fallback_groups": [
        "operational",
        "scout",
        "fallback"
      ]
    },
    "operational": {
      "description": "GDPval >=300: broad quality pool, cheapest first",
      "method": "tiered",
      "min_gdpval": 300,
      "fallback_groups": [
        "scout",
        "fallback"
      ]
    },
    "scout": {
      "description": "Any available model, cheapest first",
      "method": "tiered",
      "min_gdpval": 0,
      "fallback_groups": [
        "fallback"
      ]
    },
    "fallback": {
      "description": "Any available, cheapest first",
      "method": "tiered",
      "min_gdpval": 0,
      "fallback_groups": []
    },
    "dynamic": {
      "description": "Classifies each prompt via Ollama and routes to the appropriate group",
      "method": "dynamic",
      "classifier_model": "ollama/gemma4:12b-mlx",
      "classifier_fallback": "ollama/gemma2:2b",
      "fallback_groups": [
        "strategic",
        "tactical",
        "operational",
        "scout",
        "fallback"
      ]
    }
  },
  "model_metrics": {
    "claude-bridge/claude-sonnet-5": { "cost_per_m": 0.0000015 },
    "claude-bridge/claude-opus-5": { "cost_per_m": 0.0000015 },
    "claude-bridge/claude-fable-5": { "cost_per_m": 0.0000015 },
    "claude-bridge/claude-3-sonnet": { "cost_per_m": 0.0000015 },
    "claude-bridge/claude-3-haiku": { "cost_per_m": 0.0000015 }
  },
  "gdpval_builtin": {
