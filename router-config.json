{
  "log_level": "warn",
  "classifier_log": {
    "enabled": true,
    "store_text": "none"
  },
  "classifier_laya": {
    "enabled": false
  },
  "best_quality_window": 0.05,
  "exclude": {
    "models": []
  },
  "providers": {},
  "model_groups": {
    "simple": {
      "description": "Simple tasks and short real work - free/subscription models first, local Ollama ahead of pay-per-token",
      "method": "tiered",
      "billing_preference": "local_before_payg",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": [
        "standard"
      ]
    },
    "standard": {
      "description": "Standard tasks - GDPval >= 300, mid price band",
      "method": "tiered",
      "min_gdpval": 300,
      "max_cost": 2.0,
      "fallback_groups": [
        "simple"
      ]
    },
    "code_complex": {
      "description": "Complex coding - best-first in the 1630..1700 GDPval band",
      "method": "best",
      "min_gdpval": 1630,
      "fallback_groups": [
        "planning",
        "standard",
        "simple"
      ],
      "max_gdpval": 1700,
      "score_by": "coding"
    },
    "design": {
      "description": "Design work - best-first, GDPval >= 1600 (briefcase-sorted)",
      "method": "best",
      "min_gdpval": 1600,
      "fallback_groups": [
        "planning",
        "code_complex",
        "standard",
        "simple"
      ],
      "score_by": "briefcase"
    },
    "planning": {
      "description": "Planning and architecture - top tier only (GDPval >= 1700, reasoning-sorted: Intelligence Index, Omniscience, HLE Diamond)",
      "method": "best",
      "min_gdpval": 1700,
      "fallback_groups": [
        "code_complex",
        "standard",
        "simple"
      ],
      "score_by": "reasoning",
      "require_score_column": true
    },
    "dynamic": {
      "description": "Classifies each prompt (cloud fallback chain, local Ollama as last resort) and routes to the appropriate group",
      "method": "dynamic",
      "classifier_cloud_fallback": true
    },
    "bulk_reader": {
      "description": "Cheap-but-context-rich models for I/O-heavy subtasks (read+summarize several files). Addressable as bulk_reader/bulk_reader from subagent workflows.",
      "method": "tiered",
      "billing_preference": "cloud_first",
      "max_cost": 2.0,
      "min_context_length": 64000,
      "fallback_groups": [
        "standard",
        "simple"
      ]
    },
    "code_writer": {
      "description": "Cheap-and-fast models with enough context for a spec+one reference file (boilerplate generation). Addressable as code_writer/code_writer from subagent workflows.",
      "method": "tiered",
      "billing_preference": "cloud_first",
      "max_cost": 2.0,
      "min_context_length": 32000,
      "fallback_groups": [
        "standard",
        "simple"
      ]
    }
  },
  "model_metrics": {},
  "gdpval_builtin": {
    "magistral-small": 665,
    "magistral-medium": 669,
    "mistral-medium-3-5": 933,
    "claude-4-5-sonnet": 720,
    "claude-4-sonnet": 710,
    "claude-sonnet-5": 1603,
    "claude-fable-5": 1747,
    "claude-opus-5": 1860,
    "claude-opus-5-5": 1900,
    "devstral": 585,
    "codestral-latest": 520,
    "mistral-small-3-2": 478,
    "mistral-small-3-1": 421,
    "claude-3-5-sonnet": 720,
    "claude-3-sonnet": 680,
    "claude-3-5-haiku": 450,
    "claude-3-haiku": 350,
    "gemma4-12b": 460,
    "gemma4-27b": 520,
    "gemma3-12b": 440,
    "gemma3-27b": 510,
    "qwen3-6-35b": 620,
    "qwen3-5": 400,
    "qwen3-5-7b": 540,
    "gemma2-2b": 250,
    "gemma2-9b": 380,
    "llama3-1": 390,
    "llama3-1-8b": 390,
    "llama3-2": 410,
    "llama3-3": 430,
    "qwen3": 420,
    "mistral-nemo": 430,
    "ornith-9b": 390,
    "granite-4-micro": 280,
    "glm-4": 400,
    "glm-4-6": 520
  },
  "delegation": {
    "enabled": true,
    "expensive_groups": [
      "planning",
      "code_complex"
    ],
    "expensive_providers": []
  }
}
