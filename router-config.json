{
  "log_level": "warn",
  "non_agent_model_prefixes": [
    "mistral-small-",
    "magistral-small-",
    "ministral-",
    "voxtral-",
    "codestral-"
  ],
  "best_quality_window": 0.05,
  "exclude": {
    "models": []
  },
  "providers": {},
  "model_groups": {
    "trivial": {
      "description": "Trivial tasks - free/subscription first, local Ollama as a fallback before PAYG",
      "method": "tiered",
      "billing_preference": "local_before_payg",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": [
        "simple",
        "operational",
        "fallback"
      ]
    },
    "simple": {
      "description": "Simple tasks - free/subscription first, local Ollama as a fallback before PAYG",
      "method": "tiered",
      "billing_preference": "local_before_payg",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": [
        "operational",
        "fallback"
      ]
    },
    "standard": {
      "description": "Standard tasks - cost-effective models (GDPval >=500, cost <=5.0)",
      "method": "tiered",
      "min_gdpval": 500,
      "max_cost": 5.0,
      "fallback_groups": [
        "complex",
        "operational",
        "scout",
        "fallback"
      ]
    },
    "complex": {
      "description": "Complex tasks - strong models (GDPval >=600, cost <=10.0)",
      "method": "tiered",
      "min_gdpval": 600,
      "max_cost": 10.0,
      "fallback_groups": [
        "strategic",
        "tactical",
        "operational",
        "scout",
        "fallback"
      ]
    },
    "strategic": {
      "description": "Best available model by intelligence (max GDPval) - for heavy tasks",
      "method": "best",
      "min_gdpval": 700,
      "fallback_groups": [
        "tactical",
        "complex",
        "operational",
        "scout",
        "fallback"
      ]
    },
    "tactical": {
      "description": "High-end models for demanding tasks (best GDPval)",
      "method": "best",
      "min_gdpval": 600,
      "fallback_groups": [
        "strategic",
        "complex",
        "operational",
        "scout",
        "fallback"
      ],
      "max_gdpval": 1700,
      "score_by": "coding"
    },
    "operational": {
      "description": "Broad quality pool - cheap but capable (GDPval >=300, cost <=2.0)",
      "method": "tiered",
      "min_gdpval": 300,
      "max_cost": 2.0,
      "fallback_groups": [
        "standard",
        "scout",
        "fallback"
      ]
    },
    "planning": {
      "description": "Top-tier models only - architecture, project planning and high-stakes design decisions (GDPval >= 1700). Owner decision 2026-10-04 (ADR-0023 follow-up): planning work never goes to the daily-driver free tank.",
      "method": "best",
      "min_gdpval": 1700,
      "fallback_groups": [
        "strategic",
        "tactical",
        "operational",
        "fallback"
      ],
      "score_by": "briefcase"
    },
    "scout": {
      "description": "Any available model, cheapest first \u2014 cloud models preferred, local Ollama as last resort",
      "method": "tiered",
      "billing_preference": "cloud_first",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": [
        "fallback"
      ]
    },
    "fallback": {
      "description": "Any available, cheapest first",
      "method": "tiered",
      "max_cost": 0,
      "min_gdpval": 0,
      "fallback_groups": []
    },
    "dynamic": {
      "description": "Classifies each prompt (cloud fallback chain, local Ollama as last resort) and routes to the appropriate group",
      "method": "dynamic",
      "classifier_model": "ollama/mistral-nemo:latest",
      "classifier_fallback": "ollama/gemma2:2b",
      "classifier_cloud_fallback": true
    },
    "bulk_reader": {
      "description": "Cheap-but-context-rich models for I/O-heavy subtasks (read+summarize several files). Addressable as bulk_reader/bulk_reader from subagent workflows.",
      "method": "tiered",
      "billing_preference": "cloud_first",
      "max_cost": 2.0,
      "min_context_length": 64000,
      "fallback_groups": [
        "operational",
        "scout",
        "fallback"
      ]
    },
    "code_writer": {
      "description": "Cheap-and-fast models with enough context for a spec+one reference file (boilerplate generation). Addressable as code_writer/code_writer from subagent workflows.",
      "method": "tiered",
      "billing_preference": "cloud_first",
      "max_cost": 2.0,
      "min_context_length": 32000,
      "fallback_groups": [
        "operational",
        "scout",
        "fallback"
      ]
    }
  },
  "model_metrics": {},
