#!/bin/sh
# Pre-push gates — this repository is public, so a push is a publication.
# 1. Secret/reference scan over every commit being pushed (not just the final
#    tree). Never bypass with --no-verify; see scripts/secret-scan.ts.
# 2. The lint gate (docs/plans/2026-11-04-lint-gate.md), when the pushed
#    repository has one: it skips itself when the working tree is not what is
#    being pushed, so CI stays the authority on the pushed commit.
# Wired by `npm prepare` (git config core.hooksPath .githooks). git runs the
# hook from the repository's top level and hands it the ref list on stdin;
# both gates need it, so it is read once.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
refs=$(cat)
printf '%s\n' "$refs" | node "$hook_dir/../scripts/secret-scan.ts" --pre-push || exit $?
if [ -f scripts/lint-gate.ts ]; then
  printf '%s\n' "$refs" | node scripts/lint-gate.ts --pre-push || exit $?
fi
