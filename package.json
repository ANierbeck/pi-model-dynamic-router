{
  "name": "@anierbeck/pi-model-dynamic-router",
  "version": "2.0.0-SNAPSHOT",
  "description": "Pi extension that routes model groups to concrete models. Balances intelligence, cost, and availability.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "bin": {
    "pi-laya-model": "dist/laya-model-install.js"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc && esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-tui --external:typebox && esbuild src/laya-model-bin.ts --bundle --platform=node --format=esm --outfile=dist/laya-model-install.js && cp router-defaults.yaml router-config.json model-map.yaml dist/",
    "prepack": "npm run build",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TEST_INTEGRATION=true vitest run test/classifier.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "node scripts/lint-gate.ts",
    "format": "node scripts/format-gate.ts --write",
    "format:check": "node scripts/format-gate.ts",
    "lint:fix": "eslint src/ index.ts scripts/ test/ --fix",
    "audit:kpi": "node scripts/router-kpi-audit.ts",
    "secret-scan": "node scripts/secret-scan.ts",
    "prepublishOnly": "if [ -z \"$(git tag --points-at HEAD 2>/dev/null)\" ]; then echo 'No git tag found at current commit, skipping publish'; exit 1; fi"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "model-router",
    "llm",
    "ai"
  ],
  "author": "ANierbeck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANierbeck/pi-model-dynamic-router.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/laya-model-install.js",
    "dist/router-config.json",
    "dist/router-defaults.yaml",
    "dist/model-map.yaml",
    "laya-models/manifest.json",
    "skills/",
    "PI.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.1",
    "prettier": "^3.8.4",
    "typed-inject": "5.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
